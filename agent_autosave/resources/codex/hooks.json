{
  "hooks": {
    "SessionStart":     [{"hooks": [{"type": "command", "command": "agent-autosave hook codex SessionStart", "timeout": 5}]}],
    "UserPromptSubmit": [{"hooks": [{"type": "command", "command": "agent-autosave hook codex UserPromptSubmit", "timeout": 5}]}],
    "PostToolUse":      [{"hooks": [{"type": "command", "command": "agent-autosave hook codex PostToolUse", "async": true, "timeout": 5}]}],
    "PreCompact":       [{"hooks": [{"type": "command", "command": "agent-autosave hook codex PreCompact", "timeout": 5}]}],
    "Stop":             [{"hooks": [{"type": "command", "command": "agent-autosave hook codex Stop", "timeout": 5}]}],
    "SessionEnd":       [{"hooks": [{"type": "command", "command": "agent-autosave hook codex SessionEnd", "timeout": 3}]}]
  }
}
