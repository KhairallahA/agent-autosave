{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "agent-autosave MEMORY.md entry metadata v1",
  "description": "The JSON in a MEMORY.md bullet's <!-- m:{...} --> comment. The bullet is '- text <!-- m:{...} --> ^m-<id>'; the section it sits in decides its type when the two differ.",
  "type": "object",
  "additionalProperties": false,
  "required": ["type", "source", "added", "until", "replaces"],
  "properties": {
    "type": {"enum": ["decision", "tried", "gotcha", "convention"]},
    "source": {"type": "object", "required": ["agent", "task_id"], "properties": {"agent": {"type": "string"}, "task_id": {"type": ["string", "null"]}}},
    "added": {"type": ["string", "null"], "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "until": {"type": ["string", "null"], "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "replaces": {"type": ["string", "null"]},
    "pinned": {"type": "boolean", "const": true}
  }
}
